{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "viam:workcell-components",
  "visibility": "public",
  "url": "https://github.com/viam-labs/workcell-components",
  "description": "Generic components for palletizing/picking workcells: pallet, pick-station, safety hardware (fence, light curtain, e-stop, stack-light), decoration (tote-stack, robot-pedestal, hmi-cabinet, floor-decal, workcell-bounds), and a workcell-scene WSS service that publishes all of them to the 3D viewer.",
  "models": [
    {
      "api": "rdk:component:generic",
      "model": "viam:workcell-components:pallet"
    },
    {
      "api": "rdk:component:generic",
      "model": "viam:workcell-components:pick-station"
    },
    {
      "api": "rdk:service:world_state_store",
      "model": "viam:workcell-components:workcell-scene"
    },
    {
      "api": "rdk:component:generic",
      "model": "viam:workcell-components:safety-fence"
    },
    {
      "api": "rdk:component:generic",
      "model": "viam:workcell-components:light-curtain"
    },
    {
      "api": "rdk:component:generic",
      "model": "viam:workcell-components:e-stop"
    },
    {
      "api": "rdk:component:generic",
      "model": "viam:workcell-components:stack-light"
    },
    {
      "api": "rdk:component:generic",
      "model": "viam:workcell-components:tote-stack"
    },
    {
      "api": "rdk:component:generic",
      "model": "viam:workcell-components:robot-pedestal"
    },
    {
      "api": "rdk:component:generic",
      "model": "viam:workcell-components:hmi-cabinet"
    },
    {
      "api": "rdk:component:generic",
      "model": "viam:workcell-components:floor-decal"
    },
    {
      "api": "rdk:component:generic",
      "model": "viam:workcell-components:workcell-bounds"
    }
  ],
  "applications": [
    {
      "name": "workcell-tuner",
      "type": "single_machine",
      "entrypoint": "apps/workcell/index.html"
    }
  ],
  "markdown_link": "README.md",
  "entrypoint": "bin/workcell-components",
  "first_run": "",
  "build": {
    "build": "make module.tar.gz",
    "setup": "make setup",
    "path": "module.tar.gz",
    "arch": [
      "linux/amd64",
      "linux/arm64",
      "darwin/arm64"
    ]
  }
}
